<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.task.collate.status.mapper.UserQuestionStatusMapper">
    
    <resultMap type="UserQuestionStatus" id="UserQuestionStatusResult">
        <result property="userId"    column="user_id"    />
        <result property="questionId"    column="question_id"    />
        <result property="isInErrorbook"    column="is_in_errorbook"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectUserQuestionStatusVo">
        select user_id, question_id, is_in_errorbook, create_time, update_time from user_question_status
    </sql>

    <select id="selectUserQuestionStatusList" parameterType="UserQuestionStatus" resultMap="UserQuestionStatusResult">
        <include refid="selectUserQuestionStatusVo"/>
        <where>  
            <if test="isInErrorbook != null "> and is_in_errorbook = #{isInErrorbook}</if>
        </where>
    </select>
    
    <select id="selectUserQuestionStatusByUserId" parameterType="Long" resultMap="UserQuestionStatusResult">
        <include refid="selectUserQuestionStatusVo"/>
        where user_id = #{userId}
    </select>
        
    <insert id="insertUserQuestionStatus" parameterType="UserQuestionStatus">
        insert into user_question_status
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="questionId != null">question_id,</if>
            <if test="isInErrorbook != null">is_in_errorbook,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="questionId != null">#{questionId},</if>
            <if test="isInErrorbook != null">#{isInErrorbook},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateUserQuestionStatus" parameterType="UserQuestionStatus">
        update user_question_status
        <trim prefix="SET" suffixOverrides=",">
            <if test="questionId != null">question_id = #{questionId},</if>
            <if test="isInErrorbook != null">is_in_errorbook = #{isInErrorbook},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where user_id = #{userId}
    </update>

    <delete id="deleteUserQuestionStatusByUserId" parameterType="Long">
        delete from user_question_status where user_id = #{userId}
    </delete>

    <delete id="deleteUserQuestionStatusByUserIds" parameterType="String">
        delete from user_question_status where user_id in 
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>
</mapper>