<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.task.collate.mistakeType.mapper.MistakeTypeMapper">
    
    <resultMap type="MistakeType" id="MistakeTypeResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="mistakeName"    column="mistake_name"    />
        <result property="description"    column="description"    />
        <result property="count"    column="count"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMistakeTypeVo">
        select id, user_id, mistake_name, description, count, create_time, update_time from mistake_type
    </sql>

    <select id="selectMistakeTypeList" parameterType="MistakeType" resultMap="MistakeTypeResult">
        <include refid="selectMistakeTypeVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="mistakeName != null  and mistakeName != ''"> and mistake_name like concat('%', #{mistakeName}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="count != null "> and count = #{count}</if>
        </where>
    </select>
    
    <select id="selectMistakeTypeById" parameterType="Long" resultMap="MistakeTypeResult">
        <include refid="selectMistakeTypeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertMistakeType" parameterType="MistakeType" useGeneratedKeys="true" keyProperty="id">
        insert into mistake_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="mistakeName != null and mistakeName != ''">mistake_name,</if>
            <if test="description != null">description,</if>
            <if test="count != null">count,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="mistakeName != null and mistakeName != ''">#{mistakeName},</if>
            <if test="description != null">#{description},</if>
            <if test="count != null">#{count},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMistakeType" parameterType="MistakeType">
        update mistake_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="mistakeName != null and mistakeName != ''">mistake_name = #{mistakeName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="count != null">count = #{count},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMistakeTypeById" parameterType="Long">
        delete from mistake_type where id = #{id}
    </delete>

    <delete id="deleteMistakeTypeByIds" parameterType="String">
        delete from mistake_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>